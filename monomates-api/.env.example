SPRING_PROFILES_ACTIVE=local
DATABASE_URL=jdbc:postgresql://localhost:5432/monomates
DATABASE_USERNAME=monomates
DATABASE_PASSWORD=monomates_dev_password
JWT_SECRET=replace-this-with-at-least-32-random-characters
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# Local synthetic dataset only
DEMO_DATA_ENABLED=true

# Optional: per-remote-address web API rate limits (defaults shown below).
# AUTH_RATE_LIMIT_PER_MINUTE=30
# API_RATE_LIMIT_PER_MINUTE=300

# For a hosted PostgreSQL provider, replace DATABASE_URL with its JDBC URL.
# Keep credentials only in .env or the hosting provider's secret manager.
